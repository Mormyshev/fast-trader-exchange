datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}


enum OrderStatus {
  pending
  processing
  awaiting_payment
  paid
  completed
  cancelled
  failed
}

enum UserRole {
  user
  admin
  operator
}

enum VerificationStatus {
  not_started
  pending
  verified
  rejected
}

model Profiles {
  id           String             @id @db.Uuid
  email        String
  role         UserRole?          @default(user)
  verification VerificationStatus? @default(not_started)
  updated_at   DateTime           @default(now()) @db.Timestamptz
  username     String?
  last_name    String?
  first_name   String?
  middle_name  String?
  phone        String?
  telegram     String?
  document_number String?
  passport_url String?
  selfie_url String?
  extra_document_url String?
  verification_rejection_comment String?
  operator_pseudonym String?
  chat_pseudonym String?
  staff_active Boolean @default(false)
  is_senior_operator Boolean @default(false)
  is_blacklisted Boolean @default(false)
  blacklist_reason String?
  blacklisted_at DateTime? @db.Timestamptz
  blacklisted_by String? @db.Uuid

  orders_as_user     Orders[]     @relation("UserOrders")
  orders_as_operator Orders[]     @relation("OperatorOrders")
  chat_conversations_as_user     ChatConversation[] @relation("UserConversations")
  chat_conversations_as_operator ChatConversation[] @relation("OperatorConversations")
  chat_messages      ChatMessage[]
  staff_schedule     StaffSchedule[]
  staff_messages     StaffMessage[]
  staff_conversation_reads StaffConversationRead[]
  staff_dm_as_peer_a StaffConversation[] @relation("StaffDmPeerA")
  staff_dm_as_peer_b StaffConversation[] @relation("StaffDmPeerB")

  @@index([id, role], name: "idx_profiles_id_role")
  @@map("profiles")
}

model StaffSchedule {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operator_id String   @db.Uuid
  weekday     Int      @db.SmallInt
  starts_at   DateTime @db.Time(0)
  ends_at     DateTime @db.Time(0)
  updated_at  DateTime @default(now()) @db.Timestamptz

  operator Profiles @relation(fields: [operator_id], references: [id], onDelete: Cascade)

  @@unique([operator_id, weekday], name: "staff_schedule_operator_weekday")
  @@index([operator_id], name: "idx_staff_schedule_operator_id")
  @@map("staff_schedule")
}

model StaffConversation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @db.Timestamptz
  kind       String
  peer_a     String?  @db.Uuid
  peer_b     String?  @db.Uuid

  peerA    Profiles?               @relation("StaffDmPeerA", fields: [peer_a], references: [id], onDelete: Cascade)
  peerB    Profiles?               @relation("StaffDmPeerB", fields: [peer_b], references: [id], onDelete: Cascade)
  messages StaffMessage[]
  reads    StaffConversationRead[]

  @@index([kind], name: "idx_staff_conversations_kind")
  @@index([peer_a, peer_b], name: "idx_staff_conversations_peers")
  @@map("staff_conversations")
}

model StaffConversationRead {
  conversation_id String   @db.Uuid
  profile_id      String   @db.Uuid
  last_read_at    DateTime @default(now()) @db.Timestamptz

  conversation StaffConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  profile      Profiles          @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@id([conversation_id, profile_id], name: "staff_conversation_reads_pkey")
  @@map("staff_conversation_reads")
}

model StaffMessage {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz
  conversation_id String   @db.Uuid
  sender_id       String   @db.Uuid
  body            String?
  attachment_url  String?
  attachment_name String?
  attachment_type String?

  conversation StaffConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       Profiles          @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at(sort: Asc)], name: "idx_staff_messages_conversation_id")
  @@map("staff_messages")
}

model ChatConversation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @default(now()) @db.Timestamptz
  user_id     String   @db.Uuid
  operator_id String?  @db.Uuid
  operator_pseudonym_snapshot String?
  status      String   @default("open")

  user     Profiles      @relation("UserConversations", fields: [user_id], references: [id], onDelete: Cascade)
  operator Profiles?     @relation("OperatorConversations", fields: [operator_id], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([user_id], name: "idx_chat_conversations_user_id")
  @@index([operator_id], name: "idx_chat_conversations_operator_id")
  @@index([status, updated_at(sort: Desc)], name: "idx_chat_conversations_status_updated")
  @@map("chat_conversations")
}

model ChatMessage {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz
  conversation_id String   @db.Uuid
  sender_id       String   @db.Uuid
  body            String?
  attachment_url  String?
  attachment_name String?
  attachment_type String?

  conversation ChatConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       Profiles         @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at(sort: Asc)], name: "idx_chat_messages_conversation_id")
  @@map("chat_messages")
}

model Orders {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at      DateTime    @default(now()) @db.Timestamptz
  status          OrderStatus @default(pending)
  user_id         String?     @db.Uuid
  operator_id     String?     @db.Uuid
  currency_from   String
  currency_to     String
  amount_from     Decimal     @db.Decimal(20, 8)
  amount_to       Decimal     @db.Decimal(20, 8)
  wallet_from     String?
  wallet_to       String
  tx_hash         String?
  payment_details String?
  receipt_url     String?
  operator_receipt_url String?
  operator_pseudonym_snapshot String?
  order_number Int? @unique

  user            Profiles?   @relation("UserOrders", fields: [user_id], references: [id], onDelete: SetNull)
  operator        Profiles?   @relation("OperatorOrders", fields: [operator_id], references: [id], onDelete: SetNull)

  @@index([created_at(sort: Desc)], name: "idx_orders_created_at")
  @@index([operator_id], name: "idx_orders_operator_id")
  @@index([operator_id, status], name: "idx_orders_operator_status_composite")
  @@index([status, created_at(sort: Desc)], name: "idx_orders_status_pending_final")
  @@map("orders")
}
