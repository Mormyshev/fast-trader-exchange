datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}


enum OrderStatus {
  pending
  processing
  awaiting_payment
  paid
  completed
  cancelled
  failed
}

enum UserRole {
  user
  admin
  operator
}

enum VerificationStatus {
  not_started
  pending
  verified
  rejected
}

model Profiles {
  id           String             @id @db.Uuid
  email        String
  role         UserRole?          @default(user)
  verification VerificationStatus? @default(not_started)
  updated_at   DateTime           @default(now()) @db.Timestamptz
  username     String?
  last_name    String?
  first_name   String?
  middle_name  String?
  phone        String?
  telegram     String?
  passport_url String?
  operator_pseudonym String?

  orders_as_user     Orders[]     @relation("UserOrders")
  orders_as_operator Orders[]     @relation("OperatorOrders")
  chat_conversations_as_user     ChatConversation[] @relation("UserConversations")
  chat_conversations_as_operator ChatConversation[] @relation("OperatorConversations")
  chat_messages      ChatMessage[]

  @@index([id, role], name: "idx_profiles_id_role")
  @@map("profiles")
}

model ChatConversation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @default(now()) @db.Timestamptz
  user_id     String   @db.Uuid
  operator_id String?  @db.Uuid
  operator_pseudonym_snapshot String?
  status      String   @default("open")

  user     Profiles      @relation("UserConversations", fields: [user_id], references: [id], onDelete: Cascade)
  operator Profiles?     @relation("OperatorConversations", fields: [operator_id], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([user_id], name: "idx_chat_conversations_user_id")
  @@index([operator_id], name: "idx_chat_conversations_operator_id")
  @@index([status, updated_at(sort: Desc)], name: "idx_chat_conversations_status_updated")
  @@map("chat_conversations")
}

model ChatMessage {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz
  conversation_id String   @db.Uuid
  sender_id       String   @db.Uuid
  body            String?
  attachment_url  String?
  attachment_name String?
  attachment_type String?

  conversation ChatConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       Profiles         @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at(sort: Asc)], name: "idx_chat_messages_conversation_id")
  @@map("chat_messages")
}

model Orders {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at      DateTime    @default(now()) @db.Timestamptz
  status          OrderStatus @default(pending)
  user_id         String?     @db.Uuid
  operator_id     String?     @db.Uuid
  currency_from   String
  currency_to     String
  amount_from     Decimal     @db.Decimal(20, 8)
  amount_to       Decimal     @db.Decimal(20, 8)
  wallet_from     String?
  wallet_to       String
  tx_hash         String?
  payment_details String?
  receipt_url     String?

  user            Profiles?   @relation("UserOrders", fields: [user_id], references: [id], onDelete: SetNull)
  operator        Profiles?   @relation("OperatorOrders", fields: [operator_id], references: [id], onDelete: SetNull)

  @@index([created_at(sort: Desc)], name: "idx_orders_created_at")
  @@index([operator_id], name: "idx_orders_operator_id")
  @@index([operator_id, status], name: "idx_orders_operator_status_composite")
  @@index([status, created_at(sort: Desc)], name: "idx_orders_status_pending_final")
  @@map("orders")
}
